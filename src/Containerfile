FROM docker.io/debian:stable-backports

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_USER=true

# Pre-configurar tshark para que no requiera setuid (ejecutamos como root en el contenedor)
RUN echo "wireshark-common wireshark-common/install-setuid boolean false" | debconf-set-selections

# Instalar todas las herramientas: esenciales, build, python, red y utilidades varias
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    openssh-client \
    jq \
    ripgrep \
    bash \
    sudo \
    file \
    unzip \
    zip \
    less \
    gcc \
    g++ \
    make \
    python3-dev \
    python3 \
    python3-pip \
    python3-venv \
    nodejs \
    npm \
    iputils-ping \
    net-tools \
    iproute2 \
    tcpdump \
    tshark \
    nmap \
    dnsutils \
    traceroute \
    mtr-tiny \
    iptables \
    bind9-host \
    && rm -rf /var/lib/apt/lists/*

# Create a fake xdg-open
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open && chmod +x /usr/local/bin/xdg-open

# Crear la estructura de directorios usada por opencode.sh para XDG y PYTHONUSERBASE
RUN mkdir -p /home/opencode/.config \
             /home/opencode/.local/state \
             /home/opencode/.local/share \
             /home/opencode/.pythonuser

# Instalar opencode mediante el instalador oficial
RUN curl -fsSL https://opencode.ai/install | bash \
    && ln -sf /root/.opencode/bin/opencode /usr/local/bin/opencode

# Instalar pyright (LSP de Python por defecto de OpenCode) vía npm
RUN npm install -g pyright

# Copiar y preparar el entrypoint que decide entre modo web y TUI
COPY entrypoint.sh /usr/local/bin/opencode-entrypoint.sh
RUN chmod +x /usr/local/bin/opencode-entrypoint.sh

# Base para paquetes Python instalados por el usuario (persistente mediante volumen)
ENV PYTHONUSERBASE=/home/opencode/.pythonuser

# Directorio de trabajo por defecto: coincide con el volumen montado en opencode.sh
WORKDIR /workspace

# Puerto por defecto del servidor web de opencode
EXPOSE 4096

# Por defecto se arranca el servidor web en 0.0.0.0:4096.
# El modo TUI se activa con OPENCODE_MODE=tui (lo hace opencode.sh con --tui/--no-web).
ENTRYPOINT ["/usr/local/bin/opencode-entrypoint.sh"]
CMD ["web", "--port", "4096", "--hostname", "0.0.0.0"]
